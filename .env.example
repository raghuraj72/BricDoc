# ==============================================================================
# BricDoc Environment Variables Template
# Copy this file to .env in backend/ or root to configure your environment.
# ==============================================================================

# Application
PROJECT_NAME="BricDoc API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure 32+ character key for production: openssl rand -hex 32
SECRET_KEY="bricdoc-super-secure-production-ready-jwt-secret-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: Local SQLite (Zero-configuration required for local development)
DATABASE_URL="sqlite:///./bricdoc.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://bricdoc_user:bricdoc_password@localhost:5432/bricdoc_db"

# Storage Settings
# Local sanitized private vault storage path
STORAGE_DIR="./vault_storage"
MAX_UPLOAD_SIZE_MB=50

# AI Provider Configuration (Google Gemini)
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
DEFAULT_GEMINI_MODEL="gemini-2.5-flash"

# Background Worker Settings
MAX_WORKER_CONCURRENCY=4
JOB_TIMEOUT_SECONDS=300

# Frontend URL (for CORS)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
