# ==============================================================================
# BricDoc Production Environment Variables Template
# Copy this file to .env and fill in your actual production credentials
# ==============================================================================

# Application URL
APP_URL=https://bricdoc-raghuraj.vercel.app

# JWT Security
SECRET_KEY=generate-a-strong-random-32-char-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
DATABASE_URL=sqlite:///bricdoc.db
# For PostgreSQL Production:
# DATABASE_URL=postgresql://user:password@host:5432/bricdoc

# Razorpay Payment Gateway Credentials (Required for Real Money Payments)
# Get your keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_MODE=live

# AI Document Intelligence (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Company Billing & Invoice Settings
COMPANY_NAME=BricDoc Technologies Private Limited
COMPANY_EMAIL=billing@bricdoc.com
COMPANY_ADDRESS=Bengaluru, Karnataka, 560001, India
COMPANY_GSTIN=29ABCDE1234F1Z5
TAX_RATE_PERCENT=18.0

# CORS Origins (Comma-separated)
CORS_ORIGINS=https://bricdoc-raghuraj.vercel.app,https://bricdoc.in
